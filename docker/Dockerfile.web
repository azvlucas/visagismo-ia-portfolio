# syntax=docker/dockerfile:1.7
# Next.js standalone. BuildKit cache = deploys bem mais rápidos.
FROM node:20-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# ─── 1) Só manifests → install em cache ───
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json .npmrc ./
COPY packages/shared/package.json packages/shared/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY apps/web/package.json apps/web/
RUN mkdir -p packages/shared/src apps/web/src \
 && printf 'export {};\n' > packages/shared/src/index.ts \
 && printf 'export {};\n' > apps/web/src/placeholder.ts

RUN --mount=type=cache,id=visagismo-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store \
 && pnpm install --frozen-lockfile --filter @visagismo/web... \
    || pnpm install --filter @visagismo/web...

# ─── 2) Fonte + build Next ───
FROM deps AS build
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV API_URL=http://api:3001
ENV API_INTERNAL_URL=http://api:3001
ENV DOCKER_BUILD=1

COPY packages/shared packages/shared
COPY packages/tsconfig packages/tsconfig
COPY apps/web apps/web

RUN --mount=type=cache,id=visagismo-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store \
 && pnpm install --frozen-lockfile --filter @visagismo/web... \
    || true

RUN pnpm --filter @visagismo/shared build \
 && pnpm --filter @visagismo/web build

# ─── 3) Runtime standalone ───
FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
RUN mkdir -p ./apps/web/public
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV API_URL=http://api:3001
ENV API_INTERNAL_URL=http://api:3001
CMD ["node", "apps/web/server.js"]
