# Local development only. Never reuse these placeholder values in production.
NODE_ENV=development
REQUIRE_DB=false

APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
API_INTERNAL_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

DATABASE_URL=postgresql://visagismo:visagismo@localhost:5432/visagismo
REDIS_URL=redis://localhost:6379

# Generate independent values with: openssl rand -base64 32
INTERNAL_JOB_SECRET=
ORDER_TOKEN_SECRET=
ORDER_SESSION_SECRET=
ADMIN_JWT_SECRET=
ENCRYPTION_KEY=

# Local admin seed. Production startup requires explicit strong credentials.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me-local-admin-password

PAYMENTS_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_KEY=

# Optional S3-compatible image storage; local disk is used when unset.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=
REQUIRE_R2=false

# Optional AI providers; the deterministic mock remains available locally.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-2-image
IMAGE_PROVIDER_CHAIN=mock
IMAGE_ALLOW_MOCK=true
IMAGE_TIMEOUT_MS=120000

RESEND_API_KEY=
EMAIL_FROM=Visagismo <noreply@localhost>
SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=

NEXT_PUBLIC_BRAND_NAME=Visagismo Online
NEXT_PUBLIC_BRAND_TAGLINE=Análise de imagem pessoal com simulações e orientações práticas
NEXT_PUBLIC_ANALYSIS_MODE=automated

CRON_ENABLED=true
LGPD_EXECUTE_IMMEDIATE=true
RETENTION_ORIGINALS_DAYS=30
RETENTION_GENERATED_DAYS=90
RATE_LIMIT_PER_MINUTE=120
GENERATION_ENABLED=true
SENTRY_DSN=

