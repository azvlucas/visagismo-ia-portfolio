{
  "name": "visagismo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @visagismo/web dev",
    "dev:api": "pnpm --filter @visagismo/api dev",
    "dev:worker": "pnpm --filter @visagismo/worker dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @visagismo/db generate",
    "db:migrate": "pnpm --filter @visagismo/db migrate",
    "db:studio": "pnpm --filter @visagismo/db studio",
    "db:seed": "pnpm --filter @visagismo/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.12",
      "multer": "2.2.0",
      "postcss": "8.5.23",
      "sharp": "0.35.0"
    },
    "patchedDependencies": {
      "sharp@0.35.0": "patches/sharp@0.35.0.patch"
    }
  }
}
